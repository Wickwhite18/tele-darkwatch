# Copy to .env and adjust
DW_DB_PATH=darkwatch.db
DW_TELEGRAM_CHANNELS=dcg345,bellingcat
DW_DARKWEB_URLS=
DW_TOR_PROXY=socks5h://127.0.0.1:9050
DW_RULES_PATH=rules.json
DW_ALERT_WEBHOOK_URL=
DW_POLL_INTERVAL=300
DW_LOG_LEVEL=INFO
DW_LOG_FILE=
DW_ALERT_COOLDOWN=300
DW_RETENTION_DAYS=0

# Regex IOC rules file (used by `darkwatch ioc-scan`; empty = built-in patterns)
DW_REGEX_RULES_PATH=

# Email notifications (enabled when DW_SMTP_HOST and DW_EMAIL_TO are set)
DW_SMTP_HOST=
DW_SMTP_PORT=587
DW_SMTP_USER=
DW_SMTP_PASSWORD=
DW_SMTP_STARTTLS=true
DW_EMAIL_SENDER=darkwatch@localhost
DW_EMAIL_TO=

# --- v0.4: leak analysis & enterprise hardening ---------------------------
DW_WATCHLIST_PATH=              # JSON/txt file of corporate domains/emails
DW_NLP_TRIAGE=true              # drop scam/ad chatter before ingestion
DW_NLP_DROP_THRESHOLD=0.5

# --- v0.5: anti-friction & hardening --------------------------------------
DW_PROXY_POOL=                  # comma-separated SOCKS5/HTTP proxies
DW_SESSION_DIR=                 # directory with Telethon .session files
DW_MAX_MSGS_PER_MIN=30          # per-account rate cap (anti-ban)

# --- v0.6: SOAR / graph / userbot -----------------------------------------
DW_SOAR_WEBHOOK_URL=            # SIEM/SOC webhook for incident tickets
DW_TELEGRAM_API_ID=             # from https://my.telegram.org/apps
DW_TELEGRAM_API_HASH=           # required by `darkwatch collect-userbot`

# --- v0.7: UI / output modes -------------------------------------------------
DW_UI=rich            # 'rich' (default, interactive) or 'plain'
DW_UI_PLAIN=1         # force plain-text output everywhere (scripts/cron)
DW_JSON=1             # machine-readable JSON output for all commands
NO_COLOR=1            # accessibility: strip all ANSI color (also DW_NO_COLOR)
